<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zh.dao.mapper.my.FlowInfoMapper">

    <!-- 查询流量计基本信息 -->
    <select id="getFlowInfo" resultType="com.zh.bean.flight.FlowInfo">
        SELECT
            id,
            code,
            model,
            manufactor
        FROM flow_info
        <where>
            <if test="code != null and code !=  '' ">
                and code = #{code}
            </if>
            <if test="model != null and model !=  '' ">
                and model = #{model}
            </if>
            <if test="manufactor != null and manufactor !=  '' ">
                and manufactor = #{manufactor}
            </if>
        </where>
    </select>

    <select id="getOne" resultType="com.zh.bean.flight.FlowInfo">
        SELECT
            id,
            code,
            model,
            manufactor
        FROM flow_info
        where code = #{code}
    </select>

    <!-- 新增流量计基本信息 -->
    <update id="addFlowInfo">
        <selectKey keyProperty="id" order="AFTER" resultType="java.lang.Integer">
            SELECT LAST_INSERT_ID()
        </selectKey>
        insert into flow_info(code,model,manufactor) VALUES (#{code},#{model},#{manufactor})
    </update>

    <!-- 修改流量计基本信息 -->
    <update id="updateFlowInfo">
        update flow_info
        <set>
            <if test="code != null">
                code = #{code,jdbcType=VARCHAR},
            </if>
            <if test="model != null">
                model = #{model,jdbcType=VARCHAR},
            </if>
            <if test="manufactor != null">
                manufactor = #{manufactor,jdbcType=VARCHAR},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除流量计基本信息 -->
    <delete id="deleteFlowInfo">
        DELETE FROM flow_info WHERE id = #{id}
    </delete>



</mapper>