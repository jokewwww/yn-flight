<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zhoil</groupId>
    <artifactId>zhoil</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>

    <modules>
        <module>data_exchange</module>
        <!--        <module>fdds</module>-->
        <module>flight_change_log</module>
        <module>higer</module>
        <module>jobschedual</module>
        <module>lx_flight</module>
        <module>lx_login</module>
        <module>new_flight_info</module>
        <module>new_read_kafka</module>
        <module>oil_data</module>
        <module>schedule</module>
        <module>statistical</module>
        <module>zhoil_common</module>
        <module>zhoil_ws</module>
        <module>zhoil_zuul</module>
        <module>higer_duty</module>
        <module>zhhygis</module>
        <module>fdds_old</module>
    </modules>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>1.8</java.version>
        <docker.repository>zhoil</docker.repository>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>